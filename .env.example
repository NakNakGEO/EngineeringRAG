# Copy to .env (`make init`). .env is git-ignored. Never commit real credentials.
# Engineering OS talks to exactly one database: its own PostgreSQL (docker-compose service
# "postgres"). There is deliberately NO setting for any other database; URLs that do not
# target the internal PostgreSQL are rejected at startup (see docs/adr/0005).

EIOS_ENVIRONMENT=development
EIOS_LOG_LEVEL=INFO
EIOS_LOG_JSON=true

# Credentials for the Engineering OS PostgreSQL container (local only). Use URL-safe characters
# (letters, digits, "-", "_", ".") because the password is embedded in a URL.
EIOS_POSTGRES_USER=eios
EIOS_POSTGRES_PASSWORD=change-me-locally
EIOS_POSTGRES_DB=eios
# Host port (bound to 127.0.0.1 only) used by host-run tools and tests.
EIOS_POSTGRES_PORT=5432

# Used by processes run directly on the host (uv run ..., alembic, pytest). Containers get
# their URL from docker-compose.yml (host "postgres"), not from this value.
EIOS_DATABASE_URL=postgresql+psycopg://eios:change-me-locally@localhost:5432/eios

# Host ports (bound to 127.0.0.1 only).
EIOS_API_PORT=8000
EIOS_MCP_PORT=8082

# Directory that contains the projects Engineering OS may read. It is mounted READ-ONLY into the
# containers at /workspace; nothing outside it can be indexed. Point it at the parent folder of
# your repositories (an absolute path; on Windows use the WSL path, e.g. /mnt/c/src).
EIOS_WORKSPACE_DIR=./workspace
# For processes run directly on the host (uv run ...): comma-separated approved roots.
EIOS_WORKSPACE_ROOTS=./workspace
